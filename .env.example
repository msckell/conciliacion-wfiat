# Copy to .env and fill in. Never commit .env.

# LLM: Claude Code headless (`claude -p`), on the Claude subscription. Locally it uses the
# `claude` login. In CI set CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) as a secret.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Used once when the main model's safeguards refuse a prompt
ANTHROPIC_FALLBACK_MODEL=claude-opus-5-5
# CLAUDE_CODE_OAUTH_TOKEN=

# Without it, Slack messages are written to data/closes/<cutoff>/slack_payload.json
SLACK_WEBHOOK_URL=

# Published site, used by run-close to check the Excel link (CI sets it)
SITE_URL=https://conciliacion-wfiat.vercel.app

# GitHub issues for the tasks and CI status in the monitor. Set by GitHub Actions
# (GITHUB_TOKEN with issues: write). Locally the tasks are a dry run without them.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=msckell/conciliacion-wfiat

# Optional, all free tiers
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
DRPC_API_KEY=
# BNB Smart Chain logs (free MegaNode plan, https://dashboard.nodereal.io)
NODEREAL_API_KEY=
COINGECKO_API_KEY=

# Optional per chain RPC overrides, tried before the public list in config/chains.yaml
# RPC_URL_ETHEREUM=
# RPC_URL_BSC=
